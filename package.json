{
  "name": "llama-launcher-electron",
  "version": "1.0.0",
  "description": "llama.cpp Server Launcher - Electron GUI",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "predev": "npm run build:electron",
    "dev": "concurrently -k \"vite\" \"tsc -p tsconfig.build.json --watch\" \"esbuild src/preload/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/preload/index.js --watch\" \"wait-on tcp:127.0.0.1:5174 && electron .\"",
    "dev:renderer": "vite",
    "dev:check": "node scripts/dev-check.mjs",
    "build": "npm run build:electron && vite build",
    "build:electron": "tsc -p tsconfig.build.json && esbuild src/preload/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/preload/index.js",
    "build:renderer": "vite build",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json",
    "lint": "eslint src scripts tests",
    "test": "npm run build:electron && node --test \"tests/**/*.mjs\"",
    "test:golden": "node --test tests/params.migration.mjs",
    "args:dump": "node scripts/args-dump.mjs",
    "help:snapshot": "node scripts/param-help-snapshot.mjs",
    "preview": "vite preview",
    "pack": "electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "adm-zip": "^0.5.10",
    "axios": "^1.6.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tar": "^6.2.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/adm-zip": "^0.5.8",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^5.0.10",
    "wait-on": "^9.1.0"
  }
}
